{
  "name": "rust-python-functional-dark-theme",
  "displayName": "Eigenform Rust Python Dark",
  "description": "A dark color theme optimized for Rust and Python development.",
  "version": "0.1.19",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Themes"
  ],
  "publisher": "RichardPhillip",
  "author": {
    "name": "Richard Phillip",
    "email": "richard@eigenform.art",
    "url": "https://eigenform.art"
  },
  "license": "MIT",
  "homepage": "https://eigenform.art",
  "bugs": {
    "url": "https://github.com/richard-phillip/rust-python-functional-dark/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/richard-phillip/rust-python-functional-dark"
  },
  "icon": "media/rust-python-functional-dark.png",
  "galleryBanner": {
    "color": "#131315",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "label": "Rust Python Functional Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/Rust Python Functional Dark-color-theme.json"
      }
    ],
    "languages": [
      {
        "id": "snap",
        "aliases": [
          "Snap",
          "snap"
        ],
        "extensions": [
          ".snap"
        ],
        "configuration": "./syntaxes/snap-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "scopeName": "source.rpfd.markdown.table.injection",
        "path": "./syntaxes/markdown-table-injection.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ]
      },
      {
        "language": "snap",
        "scopeName": "source.snap",
        "path": "./syntaxes/snap.tmLanguage.json"
      }
    ]
  }
}
